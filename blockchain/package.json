{
  "name": "finnova-blockchain",
  "version": "1.0.0",
  "private": true,
  "description": "FinNova Bank smart contract (Solidity) with Hardhat tests and a local deploy script for the React DApp",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:ganache": "hardhat run scripts/deploy.js --network ganache",
    "verify:local": "npm --prefix dapp run verify:local",
    "dapp": "npm --prefix dapp run dev"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.29.1"
  }
}
